# Local environment for `vercel dev`. Copy to `.env.local` (gitignored)
# and fill in the real key. Vercel automatically loads `.env.local` for
# both `vercel dev` and `vercel build` (local prod-like build).
#
# In production, set the same variable in the Vercel project settings:
#   Project → Settings → Environment Variables → Add ANTHROPIC_API_KEY
#
# Without this key, api/ai/explain.js returns HTTP 503 with code
# "not_configured" and the Intelligence page's Ask panel shows a setup
# hint. The rest of the app (engine, narrative, insights) keeps working
# regardless.

# Anthropic API key for the AI assistant.
# Get one at https://console.anthropic.com/ → API Keys.
ANTHROPIC_API_KEY=sk-ant-...
